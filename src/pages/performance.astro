---
import BaseLayout from '../layouts/BaseLayout.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import ShortsShowcase from '../components/ShortsShowcase.astro';

const tmpShorts = [
  { id: 'vNymMy4ALYg', title: 'Elite Mindset' },
  { id: 'dAWW5s-oEgI', title: 'Daily Execution' },
  { id: 'whLW_R_7lFU', title: 'The Edge' },
];

const credentials = [
  {
    icon: '🏅',
    title: 'USATF Level 1 Certified Coach',
    org: 'USA Track & Field',
    focus: 'Sprint mechanics, acceleration, and max velocity development.',
  },
  {
    icon: '🛡️',
    title: 'NFPT Certified Personal Trainer',
    org: 'National Fitness Professionals Trainer',
    focus: 'Athletic performance, strength programming, and injury prevention.',
  },
  {
    icon: '🧠',
    title: 'Neurofeedback-Informed Training',
    org: 'Muse EEG Integration',
    focus: 'Optimizing pre-race calm, sustained focus, and recovery using data-driven mental performance protocols.',
  },
];
---

<BaseLayout title="Performance" description="Texas Movement Performance — USATF Level 1 and NFPT certified sprint coaching. Training athletes for LA 2028 with neurofeedback-informed methodology.">
  <section class="page-hero" style="--accent: #059669">
    <div class="container">
      <p class="eyebrow">Texas Movement Performance</p>
      <h1>Certified Sprint Coaching<br />for the Elite</h1>
      <p class="sub">
        USATF Level 1 and NFPT certified. Building sprinters with the methodology, 
        mechanics, and mindset to compete at the highest level.
      </p>
    </div>
  </section>

  <!-- Credentials & LA 2028 Mission -->
  <section class="credentials-section">
    <div class="container">
      <div class="credentials-grid">
        {credentials.map(c => (
          <div class="credential-card">
            <div class="credential-icon">{c.icon}</div>
            <h3>{c.title}</h3>
            <p class="credential-org">{c.org}</p>
            <p class="credential-focus">{c.focus}</p>
          </div>
        ))}
      </div>

      <div class="mission-block">
        <h2>The Mission: LA 2028</h2>
        <p>
          Training sprinters for the Los Angeles 2028 Olympic Games. Applying certified 
          methodology and neurofeedback protocols to develop athletes capable of competing 
          at the national team level. Every rep, every block start, every max velocity 
          session is built with 2028 in mind.
        </p>
        <a 
          href="mailto:contact@texasmovement.com?subject=LA%202028%20Athlete%20Inquiry" 
          class="btn-mission"
        >
          Athlete Inquiry — Train For LA 2028
        </a>
      </div>
    </div>
  </section>

  <section class="udemy-callout">
    <div class="container">
      <div class="callout-card">
        <h2>Master the Game: Elite Secrets</h2>
        <p>
          The official <strong>Elite Secrets</strong> course on Udemy. 
          A comprehensive breakdown of the frameworks, habits, and strategies 
          used to build Texas Movement from the ground up.
        </p>
        <a href="https://www.udemy.com/course/elitesecrets/" target="_blank" rel="noopener noreferrer" class="btn-udemy">
          Enroll on Udemy →
        </a>
      </div>
    </div>
  </section>

  <section class="videos">
    <div class="container">
      <h2>Featured Breakdowns</h2>
      <div class="video-grid">
        <YouTubeEmbed type="video" id="AXGxlbM04i4" title="TMP Video 1" />
        <YouTubeEmbed type="video" id="1qmvp0VjxbI" title="TMP Video 2" />
        <YouTubeEmbed type="video" id="ZGEsb4fa3Tg" title="TMP Video 3" />
      </div>
    </div>
  </section>

  <ShortsShowcase shorts={tmpShorts} />

  <section class="cta">
    <div class="container">
      <h2>Ready to Elevate Your Performance?</h2>
      <p>Join the ranks of those who refuse to settle for average.</p>
      <a href="https://www.udemy.com/course/elitesecrets/" target="_blank" rel="noopener noreferrer" class="btn">
        Get Elite Secrets
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { padding: 5rem 0 3rem; text-align: center; border-bottom: 2px solid var(--accent); }
  .eyebrow { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em; color: var(--accent); margin-bottom: 1rem; }
  h1 { font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 900; line-height: 1.15; margin-bottom: 1.25rem; }
  .sub { max-width: 600px; margin: 0 auto; font-size: 1.1rem; color: var(--color-text-muted); line-height: 1.7; }

  /* Credentials & Mission */
  .credentials-section { padding: 4rem 0; }
  .credentials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 3rem;
  }
  .credential-card {
    background: linear-gradient(135deg, var(--color-surface) 0%, rgba(5, 150, 105, 0.08) 100%);
    border: 1px solid rgba(5, 150, 105, 0.3);
    border-radius: 12px;
    padding: 2rem;
    text-align: center;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .credential-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
  }
  .credential-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }
  .credential-card h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }
  .credential-org {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
    font-weight: 600;
  }
  .credential-focus {
    color: var(--color-text);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .mission-block {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
    padding: 2.5rem 2rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--accent);
    border-radius: 12px;
  }
  .mission-block h2 {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--accent);
    margin-bottom: 1rem;
  }
  .mission-block p {
    color: var(--color-text-muted);
    line-height: 1.7;
    font-size: 1.05rem;
    margin-bottom: 2rem;
  }
  .btn-mission {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    background: var(--accent);
    color: #fff;
    padding: 1rem 2.5rem;
    border-radius: 6px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    min-width: 280px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .btn-mission:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(5, 150, 105, 0.4);
    color: #fff;
  }

  @media (max-width: 900px) {
    .credentials-grid { grid-template-columns: 1fr; }
  }

  /* Existing sections (unchanged) */
  .udemy-callout { padding: 4rem 0; }
  .callout-card {
    background: linear-gradient(135deg, var(--color-surface) 0%, rgba(5, 150, 105, 0.1) 100%);
    border: 1px solid var(--accent);
    border-radius: 12px;
    padding: 3rem 2rem;
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }
  .callout-card h2 { font-size: 1.75rem; font-weight: 800; margin-bottom: 1rem; color: var(--accent); }
  .callout-card p { color: var(--color-text-muted); line-height: 1.7; font-size: 1.05rem; margin-bottom: 2rem; max-width: 600px; margin-left: auto; margin-right: auto; }
  .btn-udemy {
    display: inline-flex; justify-content: center; align-items: center;
    background: #a435f0;
    color: #fff; padding: 1rem 2.5rem; border-radius: 6px;
    font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
    text-decoration: none; transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .btn-udemy:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(164, 53, 240, 0.4); color: #fff; }

  .videos { padding: 2rem 0 4rem; }
  .videos h2 { text-align: center; font-size: 1.75rem; font-weight: 700; margin-bottom: 2.5rem; }
  .video-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; }

  .cta { padding: 5rem 0; background: var(--color-surface); margin-top: 3rem; display: flex; flex-direction: column; align-items: center; }
  .cta .container { display: flex; flex-direction: column; align-items: center; width: 100%; text-align: center; }
  .cta h2 { font-size: 1.75rem; font-weight: 700; margin-bottom: 0.75rem; }
  .cta p { color: var(--color-text-muted); margin-bottom: 2rem; font-size: 1.05rem; max-width: 500px; }
  .btn {
    display: inline-flex; justify-content: center; align-items: center;
    background: var(--accent); color: #fff; padding: 1rem 3rem; border-radius: 6px;
    font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
    text-decoration: none; min-width: 240px; transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .btn:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(5, 150, 105, 0.4); color: #fff; }
</style>
